# 127.0.0.1 rather than localhost on purpose: this machine resolves localhost
# to ::1 first, where MongoDB is not listening. A plain standalone server is
# all that is required - no replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/equipment_ledger

PORT=3001

# The Next.js dev server. Locked down rather than "*" so the browser refuses
# writes from anywhere else, cheap as that protection is without auth.
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
